@model IEnumerable<Libro.Models.Favorite>

@{
    ViewData["Title"] = "My Favorites";
}

<span class="page-kicker">Saved for Later</span>
<h2>My Favorites</h2>

<div class="book-grid">
    @foreach (var fav in Model)
    {
        <div class="book-card">
            @if (!string.IsNullOrWhiteSpace(fav.Book?.ImageUrl))
            {
                <img src="@fav.Book.ImageUrl" alt="@fav.Book.Title" class="book-card-cover" />
            }
            else
            {
                <div class="book-card-cover-placeholder">📖</div>
            }
            <div class="book-card-body">
                <div class="book-card-title">@fav.Book?.Title</div>
                <div class="book-card-actions">
                    <a asp-controller="Books" asp-action="Details" asp-route-id="@fav.BookId" class="btn btn-sm btn-outline-secondary">View Book</a>
                    <form asp-controller="Favorite" asp-action="Toggle" method="post">
                        <input type="hidden" name="bookId" value="@fav.BookId" />
                        <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>