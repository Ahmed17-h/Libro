@model IEnumerable<Libro.Models.Author>

@{
    ViewData["Title"] = "Authors";
}

<span class="page-kicker">The Shelf</span>
<h2>Authors</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add New Author</a>

<div class="entity-grid">
    @foreach (var author in Model)
    {
        <div class="entity-card">
            @if (!string.IsNullOrWhiteSpace(author.ImageUrl))
            {
                <img src="@author.ImageUrl" alt="@author.Name" class="entity-avatar" />
            }
            else
            {
                <div class="entity-avatar-placeholder">✍️</div>
            }
            <div class="entity-name">@author.Name</div>
            <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-sm btn-secondary mb-2">Edit</a>
            <div class="entity-name">
                <a asp-action="Details" asp-route-id="@author.Id">@author.Name</a>
            </div>
            <form asp-action="Delete" asp-route-id="@author.Id" method="get">
                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
        </div>
    }
</div>